{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "path",
    "path_markdown",
    "anchor_line",
    "start_line",
    "end_line",
    "original",
    "replacement",
    "replacement_text",
    "replacement_content",
    "fence",
    "info",
    "lines_above",
    "lines_below",
    "revision",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": "review-kit-render-input/v1"
    },
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "path_markdown": {
      "type": "string",
      "minLength": 1
    },
    "anchor_line": {
      "type": "integer",
      "minimum": 1
    },
    "start_line": {
      "type": "integer",
      "minimum": 1
    },
    "end_line": {
      "type": "integer",
      "minimum": 1
    },
    "original": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "replacement": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replacement_text": {
      "type": "string"
    },
    "replacement_content": {
      "type": "string"
    },
    "fence": {
      "type": "string",
      "pattern": "^`{3,}$"
    },
    "info": {
      "type": "string",
      "pattern": "^suggestion(?::-[0-9]+\\+[0-9]+)?$"
    },
    "lines_above": {
      "type": "integer",
      "minimum": 0
    },
    "lines_below": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "head_markdown",
        "comparison",
        "comparison_markdown"
      ],
      "properties": {
        "head": {
          "type": "string",
          "minLength": 1
        },
        "head_markdown": {
          "type": "string",
          "minLength": 1
        },
        "comparison": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comparison_markdown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    }
  }
}
